# Set actual values in your deployment secret store or untracked .env.local, never in chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing remains unavailable until all required Stripe settings are supplied.
# Use a separate Supabase staging database with Stripe test mode first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PAYMENT_LINK_ID=
STRIPE_PAYMENT_LINK_URL=
# Production Payment Link supplied by the owner:
# https://buy.stripe.com/dRm00j51C3NLe139oQgEg00
# For test mode, create a separate test Payment Link and use its URL + plink_ ID.
STRIPE_LIVE_MODE=false
APP_URL=http://localhost:3000
# Long random scheduler token, unrelated to Stripe/Supabase keys.
BILLING_RECONCILE_SECRET=
